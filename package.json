{
  "name": "hive-analytics-2025",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,magenta,yellow \"vite\" \"node --watch server/index.js\" \"node --watch server/worker.js\"",
    "dev:api": "node --watch server/index.js",
    "dev:worker": "node --watch server/worker.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": "node -e \"import('./server/database.js').then(m => m.ensureTables()).then(() => console.log('Database migrated!')).catch(console.error)\""
  },
  "dependencies": {
    "@hiveio/dhive": "^1.3.2",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "express": "^4.19.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.536.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.11.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
